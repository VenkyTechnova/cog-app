# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://cognitech:cognitech@localhost:5432/cognitech
SECRET_KEY=change-me-to-a-long-random-string        # signs sessions, digest action links, unsubscribe links
APP_URL=http://localhost:5173                        # frontend base URL used in email deep links
API_URL=http://localhost:8000                        # public API URL (tracking pixel, one-click actions)
TIMEZONE=America/New_York                            # digest / reminders / business days
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth — dev (pick a seeded user) or oidc (SSO: Okta, Entra ID, Google Workspace)
# ---------------------------------------------------------------------------
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
TOKEN_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Worker / scheduler
# ---------------------------------------------------------------------------
EMBEDDED_WORKER=true            # dev: run the queue worker + cron scheduler inside the API process
WORKER_POLL_SECONDS=5

# ---------------------------------------------------------------------------
# System email: console | smtp | sendgrid | ses
# ---------------------------------------------------------------------------
MAIL_BACKEND=console
MAIL_FROM=Cognitech Talent Acquisition <talent@cognitech.example>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SENDGRID_API_KEY=
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Recruiter mailbox sync (replies arrive via POST /api/webhooks/inbound-email)
# ---------------------------------------------------------------------------
INBOX_PROVIDER=webhook          # webhook | gmail | m365
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Document storage (always encrypted at rest)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local           # local | s3
STORAGE_PATH=./storage
STORAGE_ENCRYPTION_KEY=         # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
S3_BUCKET=
S3_ENDPOINT_URL=                # for MinIO / other S3-compatible stores
S3_KMS_KEY_ID=

# ---------------------------------------------------------------------------
# AI layer: template (deterministic, no external calls) | anthropic
# ---------------------------------------------------------------------------
LLM_PROVIDER=template
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Inbound webhooks (ATS, job boards, inbox adapters): X-Webhook-Secret or X-Signature: sha256=<hmac>
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=change-me
