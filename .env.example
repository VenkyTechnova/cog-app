# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://cognitech:cognitech@localhost:5432/cognitech
# signs sessions, digest action links, unsubscribe links
SECRET_KEY=change-me-to-a-long-random-string
# frontend base URL used in email deep links
APP_URL=http://localhost:5173
# public API URL (tracking pixel, one-click actions)
API_URL=http://localhost:8000
# digest / reminders / business days
TIMEZONE=America/New_York
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth — dev (pick a seeded user) or oidc (SSO: Okta, Entra ID, Google Workspace)
# ---------------------------------------------------------------------------
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
TOKEN_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Worker / scheduler
# ---------------------------------------------------------------------------
# dev: run the queue worker + cron scheduler inside the API process
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=5

# ---------------------------------------------------------------------------
# System email: console | smtp | sendgrid | ses
# ---------------------------------------------------------------------------
MAIL_BACKEND=smtp
MAIL_FROM=Cognitech Talent Acquisition <talent@cognitech.example>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SENDGRID_API_KEY=
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Recruiter mailbox sync (replies arrive via POST /api/webhooks/inbound-email)
# ---------------------------------------------------------------------------
# webhook | gmail | m365
INBOX_PROVIDER=webhook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Document storage (always encrypted at rest)
# ---------------------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
STORAGE_PATH=./storage
# Fernet key. Leave empty to derive it from SECRET_KEY (fine for local dev), or generate one with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Set it once and never change it: documents stored under one key cannot be decrypted with another.
STORAGE_ENCRYPTION_KEY=
S3_BUCKET=
# for MinIO / other S3-compatible stores
S3_ENDPOINT_URL=
S3_KMS_KEY_ID=

# ---------------------------------------------------------------------------
# AI layer: template (deterministic, no external calls) | anthropic
# ---------------------------------------------------------------------------
LLM_PROVIDER=template
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Inbound webhooks (ATS, job boards, inbox adapters): X-Webhook-Secret or X-Signature: sha256=<hmac>
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=change-me
